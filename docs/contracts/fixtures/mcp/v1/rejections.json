{
  "contract": "modelgate-mcp-delegation-v1",
  "version": 1,
  "channel": "B",
  "note": "全部为通道 B（工具结果 isError:true + structuredContent.code）的负例。拒绝必须发生在任何提交之前：上游 mock 请求数、任务表条数、幂等登记数均不得增加。expect.details 只断言列出的键（实现可少给不可多给字段值以外的键，见契约 §4.3 白名单）。",
  "stimulusProtocol": "带 stimulus 的 case 为体积类负例，为保持 fixture 可读不内联超大字符串：发送前把 request 按 stimulus.path 定位到值，替换为 base 字符重复 stimulus.bytes 次（UTF-8 字节）。其它 case 原样发送即可。",
  "cases": [
    {
      "id": "R01-task-too-large",
      "tool": "modelgate_delegate_task",
      "given": "任务正文超过 65536 UTF-8 字节上限（正文按派发前 canonical 化计字节）",
      "request": {
        "jsonrpc": "2.0",
        "id": "r01",
        "method": "tools/call",
        "params": {
          "name": "modelgate_delegate_task",
          "arguments": {
            "task": "只读核对 docs/contracts/fixtures/mcp/v1/tools-list.json 里每个工具名、annotations 与 inputSchema 的 required 集合，输出差异清单；不要修改任何文件。",
            "idempotencyKey": "fixture-delegate-0001",
            "workspace": {
              "root": "mg-self",
              "refs": [],
              "permissionMode": "read_only"
            },
            "reasoningEffort": "high",
            "budget": {
              "maxElapsedMs": 120000,
              "maxToolCalls": 20
            },
            "parentThreadId": "codex-parent-fixture-01"
          }
        }
      },
      "stimulus": {
        "apply": "repeat_utf8",
        "path": "params.arguments.task",
        "base": "A",
        "bytes": 65537
      },
      "expect": {
        "code": "MCP_ARGUMENT_TOO_LARGE",
        "details": {
          "field": "task",
          "limit": 65536
        }
      }
    },
